/** @Tools.Site.Builder — assembles authored documentation, the specification, and the API contract */
module Site

import Std.Fs as Fs
import Std.Io as Io
import Std.Result as Result
import Constants.Site as Site
import Site.Pages as Pages

/// Assembles one documentation project; rendering is a separate build step.
fn main() -> Int {
  match assemble() {
    case Ok(pages) => {
      let _said = Io.writeLine("assembled " + show(pages) + " vault pages into " + Site.SITE_DIRECTORY)
      0
    }
    case Err(reason) => {
      let _said = Io.writeErrorLine("Site: " + reason)
      1
    }
  }
}

fn assemble() -> Result[Int, Str] {
  if Io.exists(Site.SITE_DIRECTORY) { let _cleared = Result.mapErr(Fs.removeTree(Site.SITE_DIRECTORY), |e: Fs.FsError| show(e)) ? }
  if !Io.exists("build") { Io.makeDirectory("build") ? }

  copyTree(Site.SOURCE_DIRECTORY, Site.SITE_DIRECTORY) ?

  let content = Site.SITE_DIRECTORY + "/" + Site.CONTENT_DIRECTORY
  var pages = 0

  Io.makeDirectory(content + "/rest") ?
  Io.copy(Site.CONTRACT, content + "/" + Site.CONTRACT_PAGE) ?

  for section in Site.SECTIONS { pages = pages + (publishSection(section[0], content) ?) }

  Ok(pages)
}

fn copyTree(source: Str, target: Str) -> Result[(), Str] {
  match Io.list(source) {
    case Ok(names) => {
      Io.makeDirectory(target) ?

      for name in names { copyTree(source + "/" + name, target + "/" + name) ? }

      Ok(())
    }
    case Err(_) => Io.copy(source, target)
  }
}

fn publishSection(folder: Str, content: Str) -> Result[Int, Str] {
  let source = Site.VAULT + "/" + folder
  let target = content + "/" + folder
  let names = (Io.list(source) ?).filter(|name: Str| name.endsWith(Site.MARKDOWN)).sortBy(|left: Str, right: Str| left < right)
  var entries = [entry("Overview", Site.INDEX_PAGE)]

  Io.makeDirectory(target) ?

  for name in names {
    let text = Io.read(source + "/" + name) ?
    let page = if name == Site.MAP_PAGE { Site.INDEX_PAGE } else { name }
    Io.write(target + "/" + page, Pages.published(text, folder)) ?

    if name != Site.MAP_PAGE { entries = entries.push(entry(Pages.titleOf(text, name), name)) }
  }

  Io.write(target + "/" + Site.TOC, entries.join("")) ?
  Ok(names.length())
}

fn entry(name: Str, href: Str) -> Str { "- name: \"" + name.replace("\"", "'") + "\"\n  href: " + href + "\n" }
