# The secret every scope key is derived from; at least 32 characters. Rotating it invalidates every token.
GRAIL_SECRET=
GRAIL_HOST=127.0.0.1
GRAIL_PORT=7420
GRAIL_LOG_LEVEL=information
GRAIL_WORKERS=64
GRAIL_CONNECTIONS=0
GRAIL_ALLOWED_ORIGINS=
# Set only when the fabric is reachable solely through a proxy that writes the client address, e.g. CF-Connecting-IP behind Cloudflare.
GRAIL_CLIENT_IP_HEADER=
