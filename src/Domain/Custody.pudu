/** @Domain.Custody.Secrets — secrets a scope holds for its participants, sealed, and the policy that says who may use them */
module Domain.Custody

/** @Domain.Custody.Deposit — a value given to custody under a name, with who receives it, who may ask for it, in which kinds, how often, and until when */
export type Deposit = {
  name: Str,
  value: Str,
  graph: Str,
  audience: Array[Str],
  senders: Array[Str],
  kinds: Array[Str],
  uses: Option[Int],
  expires: Option[Int],
  description: Option[Str]
}

/** @Domain.Custody.Held — a secret as custody keeps it: its policy, its value sealed under a nonce used once, and how often and when deliveries last held it */
export type Held = {
  name: Str,
  version: Int,
  graph: Str,
  audience: Array[Str],
  senders: Array[Str],
  kinds: Array[Str],
  uses: Option[Int],
  expires: Option[Int],
  description: Option[Str],
  created: Int,
  nonce: Bytes,
  sealed: Bytes,
  reveals: Int,
  revealed: Option[Int]
}

/** @Domain.Custody.Sealing — a deposit with the nonce drawn for it and the time it arrived */
export type Sealing = { deposit: Deposit, nonce: Bytes, now: Int }
