/** @Config.Settings.Environment — what the fabric reads at start */
module Config.Settings

import Std.App.Secret as Secret
import Std.Result as Result
import Constants.Environment as Names
import Constants.Security as Security
import PuduLangEnvironment.Binding as Binding
import PuduLangEnvironment as Environment
import PuduLangEnvironment.Loader as Loader
import PuduLangEnvironment.Options as Options
import PuduLangEnvironment.Settings as Bound
import PuduLangEnvironment.Variables as Variables
import PuduLangValidator.Rule as Rule
import PuduLangValidator.Rules.Number as NumberRule
import PuduLangValidator.Rules.Text as TextRule
import PuduLangValidator.Validator as Validator

/** @Config.Settings.Settings — address, secret, logging, and capacity */
export type Settings = {
  @env("GRAIL_HOST") @default("127.0.0.1") host: Str,
  @env("GRAIL_PORT") @default("7420") port: Int,
  @env("GRAIL_SECRET") @secret secret: Secret.Secret,
  @env("GRAIL_LOG_LEVEL") @default("information") logLevel: Str,
  @env("GRAIL_WORKERS") @default("64") workers: Int,
  @env("GRAIL_CONNECTIONS") @default("0") connections: Int,
  @env("GRAIL_ALLOWED_ORIGINS") @default("") allowedOrigins: Str,
  @env("GRAIL_CLIENT_IP_HEADER") @default("") clientIpHeader: Str
} derives Binding.Bind, Binding.Redacted

/// The settings from `.env`, when present, over the process environment, bound and validated.
export fn load() -> Result[Settings, Str] {
  let bound = Result.andThen(Loader.load(&Options.defaults()), |variables: Variables.Variables| Bound.bind(&variables, &rules()))
  Result.mapErr(bound, |problem: Environment.Problem| Environment.describe(&problem))
}

/// The settings from the given variables alone, for tests and tools.
export fn loadFrom(variables: &Map[Str, Str]) -> Result[Settings, Str] {
  let bound = Result.andThen(Loader.loadOver(&Options.defaults(), variables), |found: Variables.Variables| Bound.bind(&found, &rules()))
  Result.mapErr(bound, |problem: Environment.Problem| Environment.describe(&problem))
}

/// The fabric secret.
export fn secretOf(settings: &Settings) -> Str { Secret.reveal(&settings.secret) }

/// The origins allowed cross-origin access.
export fn origins(settings: &Settings) -> Array[Str] {
  settings.allowedOrigins.split(Names.ORIGIN_SEPARATOR).map(|origin: Str| origin.trim()).filter(|origin: Str| !origin.isEmpty())
}

fn rules() -> Validator.Validator[Settings] {
  let secret = Rule.build(Rule.withCode(Rule.must(Rule.ruleFor(Names.SECRET, |s: Settings| s.secret), |held: Secret.Secret| Secret.reveal(&held).length() >= Security.SECRET_LENGTH_MIN), Names.SECRET_TOO_SHORT))
  let level = Rule.build(Rule.withCode(Rule.must(Rule.ruleFor(Names.LOG_LEVEL, |s: Settings| s.logLevel), |given: Str| Names.LOG_LEVELS.contains(given)), Names.LEVEL_UNKNOWN))
  let port = Rule.build(NumberRule.inclusiveBetween(Rule.ruleFor(Names.PORT, |s: Settings| s.port), 0, Names.PORT_MAX))
  let workers = Rule.build(NumberRule.inclusiveBetween(Rule.ruleFor(Names.WORKERS, |s: Settings| s.workers), 1, Names.WORKERS_MAX))
  let connections = Rule.build(NumberRule.inclusiveBetween(Rule.ruleFor(Names.CONNECTIONS, |s: Settings| s.connections), 0, Names.CONNECTIONS_MAX))
  let host = Rule.build(TextRule.notEmpty(Rule.ruleFor(Names.HOST, |s: Settings| s.host)))
  var built = Validator.create()

  for rule in [secret, level, port, workers, connections, host] {
    built = Validator.add(built, rule)
  }

  built
}
