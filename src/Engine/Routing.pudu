/** @Engine.Routing.Resolvers — the strategy that turns a selector into recipients, chosen once */
module Engine.Routing

import Std.Json as Json
import Std.Option as Option
import Constants.Details as Details
import Constants.Extras as Extras
import Constants.Graphs as Graphs
import Contract.Limits as Limits
import Contract.Problems as Codes
import Contract.Vocabulary as Vocabulary
import Domain.Envelope as Envelope
import Domain.Graph as Graph
import Domain.Problem as Problem

/** @Engine.Routing.Sending — who sends and which kind, carried through an expansion so channels can leave the sender out */
type Sending = { source: Str, kind: Str }

/** @Engine.Routing.Resolve — the participants a sender reaches with a kind */
export type Resolve = fn(Graph.Graph, Str, Str) -> Array[Str]

/// The resolver for a selector.
export fn resolverOf(selector: &Envelope.Selector) -> Resolve {
  match selector {
    case Envelope.ToParticipant(id) => |graph: Graph.Graph, source: Str, kind: Str| if Graph.carries(&graph, source, id, kind) { [id] } else { [] }
    case Envelope.ToRole(role) => |graph: Graph.Graph, source: Str, kind: Str| reachable(&graph, source, kind, |member: Graph.Participant| member.roles.contains(role))
    case Envelope.ToAbility(ability) => |graph: Graph.Graph, source: Str, kind: Str| reachable(&graph, source, kind, |member: Graph.Participant| member.abilities.contains(ability))
  }
}

/// Resolves every selected branch or refuses the whole expansion; retained paths are witnesses for later nested replies. A channel stands for its subscribers other than the sender, and one nobody else hears expands to no route at all, which the caller judges.
export fn routes(graph: &Graph.Graph, participants: &Array[Str], graphs: &Map[Str, Graph.Graph], source: Str, kind: Str) -> Result[Array[Envelope.Route], Problem.Problem] {
  let sending = Sending{source: source, kind: kind}
  var found: Array[Envelope.Route] = []

  if participants.isEmpty() { return Err(Problem.of(Codes.NO_ROUTE, Details.NO_ROUTE)) }

  for id in *participants {
    let branch = expanded(graph, id, graphs, &sending, 0, Limits.ROUTING_PATHS - found.length(), &[]) ?
    found = found.concat(branch)
  }

  Ok(found)
}

/// The participants a channel delivers a kind to: every target of a flow edge from the channel that carries the kind, except the sender.
export fn subscribers(graph: &Graph.Graph, channel: Str, source: Str, kind: Str) -> Array[Str] {
  graph.participants.filter(|member: Graph.Participant| member.id != source && member.id != channel && Graph.carries(graph, channel, member.id, kind)).map(|member: Graph.Participant| member.id)
}

/// The participant a selector names directly, if it names one.
export fn named(selector: &Envelope.Selector) -> Option[Str] {
  match selector {
    case Envelope.ToParticipant(id) => Some(id)
    case _ => None
  }
}

fn reachable(graph: &Graph.Graph, source: Str, kind: Str, holds: fn(Graph.Participant) -> Bool) -> Array[Str] {
  graph.participants.filter(|member: Graph.Participant| member.id != source && holds(member) && Graph.carries(graph, source, member.id, kind)).map(|member: Graph.Participant| member.id)
}

fn expanded(graph: &Graph.Graph, id: Str, graphs: &Map[Str, Graph.Graph], sending: &Sending, depth: Int, remaining: Int, prefix: &Array[Envelope.Address]) -> Result[Array[Envelope.Route], Problem.Problem] {
  if depth > Limits.CONTAINMENT_DEPTH { return Err(exceeded(Limits.CONTAINMENT_DEPTH)) }
  if remaining < 1 { return Err(exceeded(Limits.ROUTING_PATHS)) }

  let member = Option.okOr(Graph.participant(graph, id), Problem.of(Codes.NO_ROUTE, Details.NO_ROUTE)) ?
  let address = Envelope.Address{graph: graph.id, participant: id}
  let path = prefix.push(address)

  if member.kind == Vocabulary.PARTICIPANT_CHANNEL { return fanned(graph, id, graphs, sending, depth, remaining, &path) }
  if member.kind != Vocabulary.PARTICIPANT_GRAPH { return Ok([Envelope.Route{recipient: address, path: path}]) }

  let name = Option.okOr(member.graph, Problem.of(Codes.NOT_FOUND, Details.NOT_FOUND)) ?
  let nested = Option.okOr(graphs.get(name), Problem.of(Codes.NOT_FOUND, Details.NOT_FOUND)) ?
  let entries = nested.participants.filter(|candidate: Graph.Participant| candidate.roles.contains(Graphs.ENTRY_ROLE))
  var found: Array[Envelope.Route] = []

  if entries.isEmpty() { return Err(Problem.of(Codes.NO_ROUTE, Details.NO_ROUTE)) }

  for entry in entries {
    let branch = expanded(&nested, entry.id, graphs, sending, depth + 1, remaining - found.length(), &path) ?
    found = found.concat(branch)
  }

  Ok(found)
}

fn fanned(graph: &Graph.Graph, channel: Str, graphs: &Map[Str, Graph.Graph], sending: &Sending, depth: Int, remaining: Int, path: &Array[Envelope.Address]) -> Result[Array[Envelope.Route], Problem.Problem] {
  let listening = subscribers(graph, channel, sending.source, sending.kind)
  var found: Array[Envelope.Route] = []

  for id in listening {
    let branch = expanded(graph, id, graphs, sending, depth + 1, remaining - found.length(), path) ?
    found = found.concat(branch)
  }

  Ok(found)
}

fn exceeded(limit: Int) -> Problem.Problem {
  Problem.withMember(&Problem.of(Codes.LIMIT_EXCEEDED, Details.LIMIT_EXCEEDED), Extras.LIMIT, Json.Number(limit))
}
