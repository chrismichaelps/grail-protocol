/** @Engine.Journal.Written — records the fabric's own changes, graph mutations and handoffs, in the ledger as fabric-written envelopes */
module Engine.Journal

import Std.Json as Json
import Constants.Fabric as Fabric
import Constants.Ledger as Hashing
import Contract.Members as Members
import Contract.Vocabulary as Vocabulary
import Domain.Envelope as Envelope
import Domain.Graph as Graph
import Domain.Ledger as Ledger
import Domain.Mutation as Mutation
import Domain.Scope as Scope
import Engine.Admission as Admission
import Engine.Codec.Envelope as EnvelopeCodec
import Engine.Codec.Graph as GraphCodec
import Engine.Ledger as Chain
import Utils.JsonRead as JsonRead

/** @Engine.Journal.Entry — what the fabric writes: an id, where it happened, who acted, its kind, its causes, its payload, and who receives it */
export type Entry = { id: Str, graph: Str, actor: Str, kind: Str, parents: Array[Str], payload: Json.Json, recipients: Array[Envelope.Address] }

/// The scope with a graph stored and the change that produced it appended to the ledger.
export fn recorded(state: &Scope.State, graph: &Graph.Graph, mutation: &Mutation.Mutation, actor: Str, now: Int) -> Scope.State {
  let id = Hashing.MUTATION_PREFIX + graph.id + Hashing.REVISION_SEPARATOR + show(graph.revision)
  let entry = Entry{id: id, graph: graph.id, actor: actor, kind: Vocabulary.KIND_GRAPH_MUTATION, parents: [], payload: GraphCodec.mutationJson(mutation), recipients: []}
  let stored = Scope.State{..*state, graphs: state.graphs.insert(graph.id, *graph)}
  written(&stored, &entry, now)[1]
}

/// The record of a fabric-written entry and the scope with it appended to the ledger.
export fn written(state: &Scope.State, entry: &Entry, now: Int) -> (Ledger.Record, Scope.State) {
  let target = Envelope.ToParticipant(entry.actor)
  let body = JsonRead.objectOf(&[
      (Members.ENVELOPE_GRAIL, Some(Json.Text(Fabric.PROTOCOLS[0]))),
      (Members.ENVELOPE_ID, Some(Json.Text(entry.id))),
      (Members.ENVELOPE_SCOPE, Some(Json.Text(state.id))),
      (Members.ENVELOPE_GRAPH, Some(Json.Text(entry.graph))),
      (Members.ENVELOPE_SOURCE, Some(Json.Text(entry.actor))),
      (Members.ENVELOPE_TARGET, Some(EnvelopeCodec.selectorJson(&target))),
      (Members.ENVELOPE_KIND, Some(Json.Text(entry.kind))),
      (Members.ENVELOPE_PARENTS, if entry.parents.isEmpty() { None } else { Some(JsonRead.textList(&entry.parents)) }),
      (Members.ENVELOPE_PAYLOAD, Some(entry.payload))
    ])
  let digest = Chain.digestOf(&body)
  let sequence = Scope.length(state) + 1
  let envelope = Envelope.Envelope {
    grail: Fabric.PROTOCOLS[0],
    id: entry.id,
    scopeId: state.id,
    graph: entry.graph,
    source: entry.actor,
    target: target,
    kind: entry.kind,
    parents: entry.parents,
    schema: None,
    payload: Some(entry.payload),
    delivery: Envelope.Delivery{mode: Vocabulary.DELIVERY_AT_MOST_ONCE, key: None},
    priority: 0,
    deadline: None,
    clock: None,
    visibility: Vocabulary.VISIBILITY_GRAPH,
    encryption: None,
    extensions: []
  }
  let record = Ledger.Record {
    entry: Ledger.Entry{sequence: sequence, id: entry.id, digest: digest, link: Chain.linkAfter(state.link, digest)},
    envelope: envelope,
    body: body,
    stamp: Envelope.Stamp{sequence: sequence, digest: digest, accepted: now},
    recipients: entry.recipients,
    erased: false
  }
  (record, Admission.commit(state, &Admission.Admitted{record: record, lifecycle: None, closes: None}))
}
