/** @Web.Peers.Identity — names a peer by its host, so a new connection is not a new peer */
module Web.Peers

import Std.Http.Server.Route as Route
import Std.Option as Option
import Constants.Text as Text

/// Names peers before rate limiting so new connections share a window. A configured header must be overwritten by a trusted proxy that is the fabric's only ingress.
export fn byHost(header: Str) -> Route.Middleware {
  |request: Route.Request, next: Route.Handler| next(Route.Request{..request, peer: peerOf(&request, header)})
}

/// Uses the connection host unless the configured proxy header carries a nonempty address.
export fn peerOf(request: &Route.Request, header: Str) -> Str {
  let forwarded = if header.isEmpty() { None } else { Route.header(request, header) }
  let address = Option.unwrapOr(Option.map(forwarded, |value: Str| value.trim()), "")

  if address.isEmpty() { hostOf(request.peer) } else { address }
}

/// The host of a peer written `host:port` or `[v6]:port`.
export fn hostOf(peer: Str) -> Str {
  let colon = lastColon(peer)

  if peer.startsWith(Text.BRACKET_OPEN) && peer.contains(Text.BRACKET_CLOSE) { return peer.drop(1).take(peer.indexOf(Text.BRACKET_CLOSE) - 1) }
  if colon < 0 || peer.indexOf(Text.PORT_JOIN) != colon { return peer }

  peer.take(colon)
}

fn lastColon(text: Str) -> Int {
  var found = -1
  var index = 0

  for character in text.chars() {
    if character == ':' { found = index }

    index = index + 1
  }

  found
}
